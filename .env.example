# Copy to .env.local for local development. Never commit real values.
# Server-only: none of these reach the browser.

# Neon Postgres connection string (Vercel sets this when you connect the Neon database).
DATABASE_URL=

# Output of `npm run make-password` (a scrypt hash, not the password itself).
APP_PASSWORD_HASH=

# Random 32+ character secret that signs the login cookie (also printed by `npm run make-password`).
SESSION_SECRET=
